# Settings of the VR mode on the Steam Frame, read by LAUNCH-STEAM-FRAME.sh at every launch.
# One NAME=value a line. The README lists every DEVILUTIONX_VR_ variable and its default.
# deploy.sh copies this file to the Frame's data folder once and leaves an existing one alone.

# Snap turn in degrees. The game's own default is 45.
DEVILUTIONX_VR_SNAP_TURN=30

# The Frame's GPU is a phone's. Measured on it (docs/vr/steam-frame.md): 4x MSAA costs almost
# half the frame rate, 2x a third, so it is off. 2 or 4 turn it back on.
DEVILUTIONX_VR_MSAA=1
# Wall shadows take a sample per 0.4 tiles on the way to a light, 16 at most, where the default
# is always 16.
DEVILUTIONX_VR_WALL_SHADOW_SPACING=0.4
# The sun's shadows in town: four filtered comparisons a pixel where the default is nine.
DEVILUTIONX_VR_SUN_SHADOW_TAPS=4
# Nobody sees the desktop window on the Frame, so it only gets a frame a second.
DEVILUTIONX_VR_DESKTOP_WINDOW=0
# The level is drawn depth first and then shaded where it is seen. The picture is the same, and
# the heaviest frames (caves, hell, town) get 1.5 ms lighter.
DEVILUTIONX_VR_DEPTH_PREPASS=1

# Life, mana and the belt on the wrists, the game's own orbs and belt split in two, instead of
# the strip low in front. 0 brings the strip back.
DEVILUTIONX_VR_WRIST_HUD=1
