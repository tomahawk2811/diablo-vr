+/* Screen-space derivatives have a component per texture axis: none for the array layer. */
+static unsigned int hlsl_gradient_dim_count(enum hlsl_sampler_dim dim)
+{
+    switch (dim)
+    {
+        case HLSL_SAMPLER_DIM_1DARRAY:
+            return 1;
+        case HLSL_SAMPLER_DIM_2DARRAY:
+            return 2;
+        case HLSL_SAMPLER_DIM_CUBEARRAY:
+            return 3;
+        default:
+            return hlsl_sampler_dim_count(dim);
+    }
+}
